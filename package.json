{
  "name": "node-avo-inspector",
  "version": "2.0.1",
  "description": "Avo Inspector for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "repository": "https://github.com/avohq/node-avo-inspector",
  "author": "Avo (https://www.avo.app)",
  "license": "MIT",
  "private": false,
  "bugs": {
    "url": "https://github.com/avohq/node-avo-inspector/issues"
  },
  "homepage": "https://github.com/avohq/node-avo-inspector#readme",
  "scripts": {
    "build": "tsc --outDir dist",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "transform": {
      "^.+\\.[j]sx?$": "babel-jest",
      "^.+\\.[t]sx?$": "ts-jest"
    },
    "testPathIgnorePatterns": [
      "constants",
      "examples",
      "node_modules",
      "dist",
      "dist-native"
    ],
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "typescript": "*"
  },
  "dependencies": {
    "safe-regex2": "^5.0.0"
  }
}
